# Database Configuration
DB_CONTAINER=salonease-db
DB_PORT=3306
MYSQL_HOST=salonease-db
MYSQL_DATABASE=salonease_db

# MySQL Users Configuration

# --------------------------------------------------------------------------------
# DO NOT USE INLINE COMMENTS IN .env FILE BECAUSE THEY WILL BE TREATED AS VALUES
# --------------------------------------------------------------------------------

MYSQL_ROOT_PASSWORD=
MYSQL_USER=salonease_app
MYSQL_PASS=

# phpMyAdmin Configuration
PMA_HOST=salonease-db
PMA_USER=salonease_app
PMA_PASSWORD=

# JWT Configuration
JWT_SECRET=

# Application Configuration
PORT=3000
HOST=0.0.0.0

# SETUP INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace all placeholder values with actual secure values
# 3. Never commit .env to version control (add to .gitignore)
# 4. Use strong, unique passwords for production
# 5. Generate independent values, for example: openssl rand -base64 32
